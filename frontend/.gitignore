# ============================================================
# NutriSync AI — Frontend .gitignore (Expo / React Native)
# ============================================================

# Dependencies
node_modules/

# Expo
.expo/
.metro-cache/
dist/
web-build/
expo-env.d.ts

# EAS Build artifacts
eas-build-*/

# Native builds (generated by `npx expo run:android`)
# The `android/` directory is tracked, but build outputs are not.
android/build/
android/.gradle/
android/.cxx/
android/app/build/
android/app/.cxx/

# iOS (future)
ios/build/
ios/Pods/

# Native signing & secrets
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
local.properties

# Kotlin
.kotlin/

# Metro
.metro-health-check*

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# TypeScript
*.tsbuildinfo

# Bundle artifacts
*.jsbundle

# Unused template
app-example/

# Environment
.env
.env.*
!.env.example
